# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here is committed (.gitignore drops it).
# ---------------------------------------------------------------------------

# The same sheet the miner and token refresher use: Wallet Address | Token | Proxy
SHEET_ID=https://docs.google.com/spreadsheets/d/<your-sheet-id>/edit

# Service account credentials (shared on the sheet as Editor). Relative paths
# resolve against this app's folder.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Game API (defaults are fine)
GEM_BASE_URL=https://gemapi.bullshot.io

# Buy Mining Power I (+5 power, 250 gems) until power reaches TARGET_POWER.
TARGET_POWER=62
UPGRADE_ID=upg-power-1
UPGRADE_COST=250
UPGRADE_INCREMENT=5

# Energy Capacity I (+20 capacity). No price is configured on purpose: the cost
# varies by level and over time, so --energy buys until the API refuses.
ENERGY_UPGRADE_ID=upg-energy-1
ENERGY_INCREMENT=20

# Parallel wallets. Each one goes through its own proxy from the sheet.
CONCURRENCY=3

# Retries per request on 429/5xx/dropped tunnel, with backoff.
AUTH_RETRIES=3
