[TEMPLATE]
# Copy to .env and fill in (the dashboard reads the real environment, not this file).

# --- dashboard / deployment ---
PORT=4173
HOST=0.0.0.0
# Basic-auth gate for a public URL. Leave empty locally, ALWAYS set it online.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Where the uploaded sheet lives. Defaults to data/wallets.xlsx (created on upload),
# falling back to ./wallets.xlsx for local runs.
# WALLETS_FILE=data/wallets.xlsx

# --- CLI only (src/index.js), not used by the dashboard ---
GEM_BASE_URL=https://gemapi.bullshot.io
GEM_API_TOKEN=
GEM_WALLET_ADDRESS=
