[TEMPLATE]
# Copy to .env and fill in (the dashboard reads the real environment, not this file).

# --- dashboard / deployment ---
PORT=4173
HOST=0.0.0.0
# Basic-auth gate for a public URL. Leave empty locally, ALWAYS set it online.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Where the uploaded sheet lives. Defaults to data/wallets.xlsx (created on upload),
# falling back to ./wallets.xlsx for local runs.
# WALLETS_FILE=data/wallets.xlsx

# --- the wallet sheet (optional; replaces the upload) ---
# Full Google Sheet link or the bare id. Every run downloads a fresh .xlsx, so
# edits in Google apply to the next run. Share the sheet as "anyone with the link
# (viewer)" — the server fetches the export link, no Google key is involved.
# Leave both unset to use the sheet uploaded from the dashboard instead.
# WALLETS_SHEET_URL=https://docs.google.com/spreadsheets/d/<id>/edit?usp=sharing
# WALLETS_SHEET_ID=<id>

# --- auto loop (optional) ---
# The loop is always off after a start unless AUTO_START_LOOP=true.
# Loop interval is 1–1440 minutes; without it the last value from the UI is used.
# AUTO_START_LOOP=false
# LOOP_INTERVAL_MINUTES=60

# --- CLI only (src/index.js), not used by the dashboard ---
GEM_BASE_URL=https://gemapi.bullshot.io
GEM_API_TOKEN=
GEM_WALLET_ADDRESS=
