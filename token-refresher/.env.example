# ---------------------------------------------------------------------------
# Copy to .env and fill in. Nothing here is committed (.gitignore drops it).
# ---------------------------------------------------------------------------

# Google Sheet that holds Name | Wallet Address | Token | ...
# A full ".../edit?usp=sharing" link works, a bare spreadsheet id works too.
SHEET_ID=https://docs.google.com/spreadsheets/d/<your-sheet-id>/edit

# Service account credentials (must be shared on the sheet as Editor).
# Use ONE of these two:
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# The xlsx with the seed phrases: Name | Wallet Address | Seed Phrase.
KEYS_XLSX=./wallets-keys.xlsx

# Game API (defaults are fine)
GEM_BASE_URL=https://gemapi.bullshot.io

# How many BIP-44 addresses to try per seed phrase (0..N-1) before giving up.
DERIVATION_LIMIT=20

# Parallel logins. Each wallet logs in through its own proxy from the sheet.
CONCURRENCY=3

# Retries per HTTP call on 429/5xx/dropped tunnel, with backoff (default 3).
AUTH_RETRIES=3
